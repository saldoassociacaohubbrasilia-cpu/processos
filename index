  {cod:"4.3", nome:"Formação de professores concluída", dono:"Acompanhamento e Facilitação", regra:"Antes do início da trilha", f:(c)=>du(c.ini,-1)},
  {fase:"Durante o ciclo"},
  {cod:"4.4", nome:"Live de kick-off", dono:"Acompanhamento e Facilitação", regra:"No início da trilha", f:(c)=>c.ini, sug:true},
  {cod:"4.5", nome:"Questionário pré aplicado", dono:"Acompanhamento e Facilitação", regra:"Na 1ª semana", f:(c)=>du(c.ini,4), sug:true},
  {cod:"6.3", nome:"1º relatório semanal", dono:"Dados e Automação", regra:"Toda segunda-feira", f:(c)=>proxSegunda(c.ini)},
  {cod:"7.1", nome:"Questionário pós aplicado", dono:"Acompanhamento e Facilitação", regra:"Na última semana", f:(c)=>c.fim},
  {cod:"",    nome:"Fim da trilha", dono:"Coordenação", regra:"Início + duração", f:(c)=>c.fim},
  {fase:"Depois do ciclo"},
  {cod:"7.2", nome:"Ranking final e Grana+ fechados", dono:"Operação da Jornada", regra:"3 dias úteis após o fim", f:(c)=>du(c.fim,3), sug:true},
  {cod:"7.3", nome:"Premiação e evento final", dono:"Operação da Jornada", regra:"Até 2 semanas após o fim", f:(c)=>c.evento, sug:true},
  {cod:"7.6", nome:"Aprendizados do ciclo registrados", dono:"Coordenação", regra:"15 dias após o encerramento", f:(c)=>corridos(c.fim,15), sug:true},
  {cod:"7.4", nome:"Relatório final de impacto", dono:"Coordenação", regra:"30 dias após o encerramento", f:(c)=>corridos(c.fim,30)},
  {cod:"7.5", nome:"Devolutiva ao parceiro", dono:"Mobilização (Coordenação aprova)", regra:"5 dias úteis após o relatório final", f:(c)=>du(corridos(c.fim,30),5), sug:true},
  {cod:"7.7", nome:"Acessos desativados e dados tratados (LGPD)", dono:"Dados e Automação", regra:"60 dias após o encerramento", f:(c)=>corridos(c.fim,60)}
];

const DIAS=["dom","seg","ter","qua","qui","sex","sáb"];
let FER=new Set();
function iso(d){return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
function fmt(d){return DIAS[d.getDay()]+", "+String(d.getDate()).padStart(2,"0")+"/"+String(d.getMonth()+1).padStart(2,"0")+"/"+d.getFullYear();}
function util(d){return d.getDay()!==0&&d.getDay()!==6&&!FER.has(iso(d));}
function du(d,n){const r=new Date(d),s=n<0?-1:1;n=Math.abs(n);while(n>0){r.setDate(r.getDate()+s);if(util(r))n--;}return r;}
function antUtil(d){const r=new Date(d);while(!util(r))r.setDate(r.getDate()-1);return r;}
function proxUtil(d){const r=new Date(d);while(!util(r))r.setDate(r.getDate()+1);return r;}
function corridos(d,n){const r=new Date(d);r.setDate(r.getDate()+n);return antUtil(r);}
function proxSegunda(d){const r=new Date(d);r.setDate(r.getDate()+(((8-r.getDay())%7)||7));return proxUtil(r);}
function lerFeriados(){
  FER=new Set();
  document.getElementById("simFeriados").value.split(",").forEach(s=>{
    const m=s.trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
    if(m) FER.add(m[3]+"-"+m[2].padStart(2,"0")+"-"+m[1].padStart(2,"0"));
  });
}
function simular(){
  const v=document.getElementById("simInicio").value; if(!v)return;
  lerFeriados();
  const [y,m,d]=v.split("-").map(Number);
  const semanas=Math.max(1,parseInt(document.getElementById("simSemanas").value||"8",10));
  const ini=proxUtil(new Date(y,m-1,d));
  const fim=du(ini,semanas*5-1);
  const evento=du(fim,10);
  const c={ini,fim,evento}, k={};
  const rows=MARCOS.map(x=>{
    if(x.fase) return `<tr class="phase"><td colspan="5">${x.fase}</td></tr>`;
    const dt=x.f(c); k[x.cod||"fim"]=dt;
    const sug=x.sug?' <span class="sug">sugestão</span>':'';
    return `<tr><td class="cod">${x.cod}</td><td>${x.nome}</td><td>${x.dono}</td><td>${x.regra}${sug}</td><td class="d">${fmt(dt)}</td></tr>`;
  });
  document.getElementById("simBody").innerHTML=rows.join("");
  document.getElementById("simKpis").innerHTML=`
    <div class="kpi"><span>Cronograma pronto</span><b>${fmt(k["2.1"])}</b></div>
    <div class="kpi"><span>Curso liberado</span><b>${fmt(k["3.7"])}</b></div>
    <div class="kpi hl"><span>Kick-off e início</span><b>${fmt(ini)}</b></div>
    <div class="kpi"><span>Fim da trilha</span><b>${fmt(fim)}</b></div>
    <div class="kpi"><span>Relatório final de impacto</span><b>${fmt(k["7.4"])}</b></div>
    <div class="kpi hl"><span>Acessos desativados</span><b>${fmt(k["7.7"])}</b></div>`;
}
(function(){
  const h=proxSegunda(new Date(Date.now()+42*864e5));
  document.getElementById("simInicio").value=iso(h);
  ["simInicio","simFeriados","simSemanas"].forEach(id=>{
    const el=document.getElementById(id);
    el.addEventListener("input",simular); el.addEventListener("change",simular);
  });
  simular();
  const dg=document.getElementById("diagram"), a=document.getElementById("btnReal"), b=document.getElementById("btnFit");
  a.addEventListener("click",()=>{dg.classList.remove("fit");a.classList.add("on");b.classList.remove("on");});
  b.addEventListener("click",()=>{dg.classList.add("fit");b.classList.add("on");a.classList.remove("on");});
})();
</script>
