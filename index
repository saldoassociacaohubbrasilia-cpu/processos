<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fluxo dos processos do Saldo+</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #002364; --cyan: #00B4D8; --orange: #F28C28; --magenta: #C2185B;
    --bg: #F5F7FB; --card: #FFFFFF; --text: #1B2433; --muted: #5A6475; --line: #D7DDE8;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Poppins", Arial, sans-serif; background: var(--bg); color: var(--text); line-height: 1.5; }
  header { background: var(--navy); color: #fff; padding: 28px 32px; }
  header h1 { margin: 0 0 4px; font-size: 24px; font-weight: 600; }
  header p { margin: 0; opacity: .85; font-size: 14px; }
  main { max-width: 1280px; margin: 0 auto; padding: 24px 16px 48px; }
  section { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 24px; margin-bottom: 24px; }
  h2 { margin: 0 0 6px; font-size: 18px; color: var(--navy); font-weight: 600; }
  h3 { font-size: 14px; color: var(--navy); margin: 22px 0 8px; font-weight: 600; }
  .sub { margin: 0 0 18px; color: var(--muted); font-size: 13px; }
  .steps { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .steps span { font-size: 12px; font-weight: 500; padding: 6px 12px; border-radius: 999px; background: #E8EEF9; color: var(--navy); }
  .steps span b { color: var(--orange); margin-right: 4px; }
  .diagram { overflow: auto; border: 1px solid var(--line); border-radius: 8px; background: #fff; max-height: 82vh; }
  .diagram svg { display: block; }
  .diagram.fit svg { width: 100%; height: auto; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  .toolbar small { color: var(--muted); font-size: 12px; }
  .toolbar button { font-family: inherit; font-size: 12px; font-weight: 500; border: 1px solid var(--navy); background: #fff; color: var(--navy); padding: 6px 14px; border-radius: 999px; cursor: pointer; }
  .toolbar button.on { background: var(--navy); color: #fff; }
  .legend { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 14px; font-size: 12px; color: var(--muted); align-items: center; }
  .legend div { display: flex; align-items: center; gap: 6px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { border: 1px solid var(--line); padding: 9px 10px; text-align: left; vertical-align: top; }
  th { background: var(--navy); color: #fff; font-weight: 500; }
  tbody tr:nth-child(even) td { background: #F8FAFD; }
  .table-wrap { overflow-x: auto; }
  td.c { text-align: center; font-weight: 600; width: 80px; }
  td ul { margin: 0; padding-left: 18px; }
  .R { color: var(--orange); } .A { color: var(--magenta); } .C { color: #0089A8; } .I { color: var(--muted); }
  .phase td { background: #E8EEF9 !important; font-weight: 600; color: var(--navy); }
  code { background: #EEF2F8; padding: 1px 5px; border-radius: 4px; font-size: 12px; }
  .note { font-size: 12px; color: var(--muted); margin-top: 12px; }
  .roles { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .role { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .role h4 { margin: 0 0 6px; color: var(--navy); font-size: 14px; font-weight: 600; border-left: 4px solid var(--orange); padding-left: 8px; }
  .role ul { margin: 0; padding-left: 18px; font-size: 13px; }
  .role-ap { font-size: 12px; color: var(--muted); margin: 8px 0 0; }
  .sla-pill { font-size: 12px; font-weight: 600; color: #006C85; background: #E3F6FA; border-radius: 999px; padding: 2px 10px; white-space: nowrap; display: inline-block; }
  .sla-pill.wk { color: #7A4300; background: #FFF1DF; }
  .sla-pill.ev { color: var(--magenta); background: #FBE7EF; }
  .sla-pill.ct { color: var(--muted); background: #EEF1F5; }
  .sim { display: flex; flex-wrap: wrap; gap: 14px 22px; align-items: flex-end; background: #F8FAFD; border: 1px solid var(--line); border-radius: 8px; padding: 14px; margin-bottom: 16px; }
  .sim label { display: flex; flex-direction: column; gap: 4px; font-size: 12px; font-weight: 500; color: var(--navy); }
  .sim label.chk { flex-direction: row; align-items: center; gap: 8px; padding-bottom: 8px; }
  .sim input[type=date], .sim input[type=text], .sim input[type=number] { font-family: inherit; font-size: 13px; padding: 7px 10px; border: 1px solid var(--line); border-radius: 8px; background: #fff; color: var(--text); }
  .sim input[type=text] { min-width: 240px; }
  .sim input[type=number] { width: 90px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 16px; }
  .kpi { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; background: #fff; }
  .kpi span { display: block; font-size: 11.5px; color: var(--muted); }
  .kpi b { display: block; font-size: 16px; color: var(--navy); font-weight: 600; margin-top: 2px; }
  .kpi.hl { border-color: var(--orange); background: #FFF6EC; }
  td.d { white-space: nowrap; font-weight: 500; }
  td.cod { font-weight: 600; color: var(--navy); white-space: nowrap; width: 52px; }
  tr.gwrow td { background: #F6F1FC !important; }
  .obs { font-size: 12px; color: var(--muted); margin-top: 3px; }
  .st { font-size: 11.5px; font-weight: 600; border-radius: 999px; padding: 2px 9px; white-space: nowrap; display: inline-block; }
  .st-novo { background: #FAECE7; color: #A8431F; } .st-aj { background: #FFF6D6; color: #7A5A00; } .st-ex { background: #EEF1F5; color: var(--muted); }
  .sug { font-size: 10.5px; font-weight: 600; color: var(--muted); border: 1px dashed #9AA8C2; border-radius: 999px; padding: 1px 7px; margin-left: 6px; white-space: nowrap; }
  @media (max-width: 600px) { header { padding: 22px 16px; } section { padding: 16px; } }
  @media print {
    @page { size: A3 landscape; margin: 10mm; }
    body { background: #fff; }
    section { border: none; padding: 0 0 16px; }
    .diagram { overflow: visible; border: none; max-height: none; }
    .diagram svg { width: 100%; height: auto; }
    .toolbar, .sim { display: none; }
    header, th, .phase td { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  }
</style>
</head>
